# CareCircle Environment Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# In-Memory Fallback Store (set to true for full zero-dependency local demo/tests)
USE_IN_MEMORY_FALLBACK=true

# Notification Channels & Escalation
EXPO_PUSH_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Background Tasks & Engine
BACKGROUND_TICK_SECONDS=15
STALE_DETECTION_INTERVAL_SECONDS=15
